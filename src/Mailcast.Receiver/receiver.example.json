{
  // Where the audio comes from. One of:
  //   "ubersdr:wessex.zapto.org"       a web receiver; the receiver tunes it itself
  //   "plughw:CARD=Device,DEV=0"       a sound card on your radio, set to USB on "dialKHz"
  //   "wav:/path/to/recording.wav"     a recording, for testing
  "audio": "ubersdr:wessex.zapto.org",

  // The USB dial in kHz. The web SDR is tuned here, and your radio should be too if you use
  // a sound card. The signal is centred 1800 Hz above it, on 7.0538 MHz.
  "dialKHz": 7052.0,

  // Your BBS. "type" is "linBpq" or "fbb". For LinBPQ the port is the FBBPORT in its
  // Telnet port, and the login is the USER= name you made for the receiver.
  "bbs": {
    "type": "linBpq",
    "host": "127.0.0.1",
    "port": 8011,
    "login": "Q0CAST",
    "password": "change-me",
    "command": "BBS"
  },

  // The status page. It is on this machine only unless "lan" is true, and on the network
  // it needs a password, which the browser asks for.
  "web": {
    "port": 8130,
    "lan": false,
    "password": ""
  },

  // GB7RDG's slots: one at "slotUtc" (UTC), then one every "everyMinutes", so every hour
  // on the hour, but only in daylight: from 2 hours after sunrise to 30 minutes before sunset
  // near Reading (IO91lk). Once the receiver has heard GB7RDG's directory, which gives its
  // slots, it uses that instead. A sound card listens all the time.
  "slotUtc": "00:00",
  "everyMinutes": 60,
  "daylight": { "locator": "IO91lk", "afterSunriseMinutes": 120, "beforeSunsetMinutes": 30 },

  // A public web SDR allows each address about 3 hours a day, so it only listens to this many
  // of each day's daylight slots, spread evenly, from 2 minutes before each to 12 after.
  // 12 is the most.
  "webSdrSlotsPerDay": 8,

  // The receiver keeps its own copy of each bulletin once your BBS has answered for it, to
  // read on the status page or send to the BBS again: for "days", and "maxMegabytes" in all,
  // the oldest going first. 0 for either keeps none.
  "archive": { "days": 30, "maxMegabytes": 50 },

  // To share your radio with LinBPQ packet, the receiver can retune it for each slot: add
  // "rig" and "bpq" as docs/receiver.md says under "Sharing a radio with LinBPQ".

  "stateDirectory": "/var/lib/pdn-mailcast"
}
