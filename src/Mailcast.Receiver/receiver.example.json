{
  // Where the audio comes from. One of:
  //   "ubersdr:wessex.zapto.org"       a web receiver; the receiver tunes it itself
  //   "plughw:CARD=Device,DEV=0"       a sound card on your radio, set to USB on "dialKHz"
  //   "soundmodem"                     the pdn-soundmodem on this machine ("soundmodem:PORT" if not on 8107)
  //   "sdrconnect:192.168.1.20"        an SDRplay radio in SDRconnect on another computer; the receiver tunes it
  //   "wav:/path/to/recording.wav"     a recording, for testing
  "audio": "ubersdr:wessex.zapto.org",

  // Where your radio is, as a 4 or 6 character Maidenhead locator, for a sound card,
  // soundmodem, sdrconnect or a recording. It names the radio path's hops and goes in the daily report.
  // A web SDR says where it is itself, so with one this is not used.
  // "locator": "IO91lk",

  // The USB dial in kHz. The web SDR is tuned here, and your radio should be too if you use
  // a sound card. The signal itself always stays on 7.0538 MHz: the best dial for a sound card
  // is 7.0538 MHz minus the middle of its own receive filter, which the status page's "Measure
  // my filter" works out for you. See docs/receiver.md.
  "dialKHz": 7052.0,

  // The callsigns the broadcast is accepted from, any SSID. GB7RDG sends it today, and it may
  // move to M0LTE. Frames from anyone else are ignored. Left out, it is these two.
  "sources": ["GB7RDG", "M0LTE"],

  // Your BBS. "type" is "linBpq" or "fbb". For LinBPQ the port is the FBBPORT in its
  // Telnet port, and the login is the USER= name you made for the receiver.
  "bbs": {
    "type": "linBpq",
    "host": "127.0.0.1",
    "port": 8011,
    "login": "Q0CAST",
    "password": "change-me",
    "command": "BBS"
  },

  // The status page, on this machine and the local network. "lan": false keeps it to this
  // machine. A "password", if set, is asked for by the browser; without one, anyone who can
  // reach the page can change the settings, the BBS login included.
  "web": {
    "port": 8130,
    "lan": true,
    "password": ""
  },

  // GB7RDG's slots: at "minute" past the hour (UTC), then one every "everyMinutes", so every hour
  // on the hour, but only in daylight: from 2 hours after sunrise to 30 minutes before sunset
  // near Reading (IO91lk). Once the receiver has heard GB7RDG's directory, which gives its
  // slots, it uses that instead. A sound card decodes from 2 minutes before each slot until
  // it is over, and rests between slots unless a status page shows the spectrogram. A web SDR listens from 2
  // minutes before each daylight slot to 12 after, which is every slot for most of the year;
  // near midsummer it skips the earliest morning ones to stay inside its 3 hours a day.
  "minute": 0,
  "everyMinutes": 60,
  "daylight": { "locator": "IO91lk", "afterSunriseMinutes": 120, "beforeSunsetMinutes": 30 },

  // The receiver keeps its own copy of each bulletin once your BBS has answered for it, to
  // read on the status page or send to the BBS again: for "days", and "maxMegabytes" in all,
  // the oldest going first. 0 for either keeps none.
  "archive": { "days": 30, "maxMegabytes": 50 },

  // To share your radio with LinBPQ packet, the receiver can retune it for each slot: add
  // "rig" and "bpq" as docs/receiver.md says under "Sharing a radio with LinBPQ".

  // With "audio": "soundmodem", "retune": true has pdn-soundmodem tune its own radio to
  // "dialKHz" for each slot and hold its transmitting meanwhile: see docs/receiver.md under
  // "Retuning through pdn-soundmodem".

  // To run commands of your own before and after each slot (to stop another program that
  // shares your radio, and start it again), add "hooks" as docs/receiver.md says under
  // "Running your own commands around each slot".

  // To send M0LTE a short report each day of what your receiver heard, add
  // "feedback": { "enabled": true, "callsign": "your callsign" }, as docs/receiver.md says
  // under "Sending a daily report".

  // GB7RDG's directory signing key is built in, so the status page shows its signed bulletins
  // as "signed by GB7RDG". To trust another transmitter as well, add its label and the public
  // key from its head end's start-up line, as docs/receiver.md says under "Signed directories":
  // "trustedKeys": [ { "label": "GB7XYZ", "publicKey": "..." } ],

  "stateDirectory": "/var/lib/pdn-mailcast"
}
