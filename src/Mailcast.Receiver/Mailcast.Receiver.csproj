<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Mailcast.Receiver</RootNamespace>
    <AssemblyName>pdn-mailcast-receiver</AssemblyName>
    <IsPackable>false</IsPackable>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="pdn-soundmodem" />
    <!-- WASAPI sound cards, used only on Windows (behind OperatingSystem.IsWindows()); it builds anywhere. -->
    <PackageReference Include="pdn-soundmodem-windows" />
    <!-- Running as a Windows service; likewise Windows-only, and builds anywhere. -->
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Packet.Mailcast\Packet.Mailcast.csproj" />
    <PackageReference Include="Packet.Fbb" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\index.html" LogicalName="Mailcast.Receiver.Web.index.html" />
    <EmbeddedResource Include="Web\signin.html" LogicalName="Mailcast.Receiver.Web.signin.html" />
    <EmbeddedResource Include="Web\openapi.json" LogicalName="Mailcast.Receiver.Web.openapi.json" />
    <EmbeddedResource Include="Web\vendor\scalar\standalone.js.gz" LogicalName="Mailcast.Receiver.Web.scalar.js.gz" />
    <EmbeddedResource Include="Web\globe.json" LogicalName="Mailcast.Receiver.Web.globe.json" />
    <EmbeddedResource Include="Data\towns.txt.gz" LogicalName="Mailcast.Receiver.Data.towns.txt.gz" />
    <EmbeddedResource Include="Data\sea-areas.txt.gz" LogicalName="Mailcast.Receiver.Data.sea-areas.txt.gz" />
    <EmbeddedResource Include="Data\shipping-forecast-areas.txt.gz" LogicalName="Mailcast.Receiver.Data.shipping-forecast-areas.txt.gz" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shipped stations file: beside the program, and packaged to /usr/share/pdn-mailcast-receiver (scripts/build-receiver-deb.sh). -->
    <None Include="stations.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mailcast.Receiver.Tests" />
  </ItemGroup>

</Project>
