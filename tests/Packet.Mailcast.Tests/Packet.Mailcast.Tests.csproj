<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xunit convention: Method_Scenario_Expectation test names. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Three bulletins exactly as head end 0.3.0 left them in GB7RDG's store on 2026-10-06. -->
    <None Include="Gb7rdgStore\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Real answers from GIRO and PROPquest, fetched once on 2026-10-06 at about 17:23 UTC (the asker's IP address removed from GIRO's). -->
    <None Include="Propagation\*.json;Propagation\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- 34 messages from PSK Reporter's public MQTT feed on 2026-10-06 at about 19:35 UTC, as they came (public spot data: callsigns and locators, no addresses). -->
    <None Include="Propagation\*.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Packet.Mailcast\Packet.Mailcast.csproj" />
  </ItemGroup>

</Project>
