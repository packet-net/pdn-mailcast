#!/bin/sh
set -e

EXAMPLE=/usr/share/pdn-mailcast-headend/headend.example.json
CONFIG=/etc/pdn-mailcast-headend/headend.json
UNIT=pdn-mailcast-headend.service
# Written by prerm on upgrade: the template instances it stopped, for postinst to start again.
INSTANCES=/run/pdn-mailcast-headend.upgrade-instances

case "$1" in
  configure)
    if ! getent passwd pdn-mailcast-headend >/dev/null; then
        adduser --system --no-create-home --home /var/lib/pdn-mailcast-headend --group pdn-mailcast-headend
    fi
    # The config holds the station's API key and the BBS password: no access for anyone else.
    install -d -o root -g pdn-mailcast-headend -m 0750 /etc/pdn-mailcast-headend
    if [ ! -e "$CONFIG" ]; then
        install -o root -g pdn-mailcast-headend -m 0640 "$EXAMPLE" "$CONFIG"
        echo "pdn-mailcast-headend: put an example config in $CONFIG."
        echo "  Set up the station and the BBS (see /usr/share/doc/pdn-mailcast-headend/headend.md),"
        echo "  put your callsign, locator, the station's API key and the BBS password in $CONFIG, then:"
        echo "  systemctl start pdn-mailcast-headend"
        echo "  A second head end is /etc/pdn-mailcast-headend/NAME.json and"
        echo "  systemctl enable --now pdn-mailcast-headend@NAME (see headend.md)."
    fi
    # Every head end signs its directories: make the key if there is none (never replacing a
    # key that has content), and on every configure give it to the service user alone, which
    # also covers a reinstall after a purge gave the user a new UID.
    KEY=/etc/pdn-mailcast-headend/signing-key.pem
    if [ -e "$KEY" ] && [ ! -s "$KEY" ]; then
        rm -f "$KEY"
    fi
    if [ ! -e "$KEY" ]; then
        /usr/bin/pdn-mailcast-headend --make-key || echo "pdn-mailcast-headend: could not make $KEY; run: sudo pdn-mailcast-headend --make-key" >&2
    fi
    if [ -e "$KEY" ]; then
        chown pdn-mailcast-headend:pdn-mailcast-headend "$KEY"
        chmod 0600 "$KEY"
    fi
    ;;
esac

# Template instances (pdn-mailcast-headend@NAME) currently running, one unit name per line; empty
# when systemd is not running. They are the operator's: never enabled or started by the package,
# but restarted on upgrade like the plain unit.
running_instances() {
    if [ -d /run/systemd/system ] && command -v systemctl >/dev/null; then
        systemctl list-units --plain --no-legend --state=active,activating 'pdn-mailcast-headend@*.service' 2>/dev/null \
            | awk '{print $1}'
    fi
}

if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ]; then
    if command -v deb-systemd-helper >/dev/null; then
        deb-systemd-helper unmask "$UNIT" >/dev/null || true
        if deb-systemd-helper --quiet was-enabled "$UNIT"; then
            deb-systemd-helper enable "$UNIT" >/dev/null || true
        else
            deb-systemd-helper update-state "$UNIT" >/dev/null || true
        fi
    fi
    if [ -d /run/systemd/system ] && command -v systemctl >/dev/null; then
        systemctl --system daemon-reload >/dev/null || true
        # Not started on a first install: the station and the BBS have to be set up first. An
        # upgrade restarts a head end that was running, so it picks up the new binary.
        if [ -n "${2:-}" ] && command -v deb-systemd-invoke >/dev/null; then
            if [ -e /run/pdn-mailcast-headend.upgrade-was-running ]; then
                # Stopped by the old version's prerm for the upgrade: start it again.
                rm -f /run/pdn-mailcast-headend.upgrade-was-running
                deb-systemd-invoke start "$UNIT" >/dev/null || true
            else
                # From a version whose prerm left it running: restart it if it still is.
                deb-systemd-invoke try-restart "$UNIT" >/dev/null || true
            fi
            # The instances the old prerm stopped, then any it left running on the old binary.
            if [ -e "$INSTANCES" ]; then
                # systemctl, not deb-systemd-invoke, which skips a unit that is not enabled: an
                # instance started by hand is started again too.
                for _unit in $(cat "$INSTANCES"); do
                    systemctl start "$_unit" >/dev/null || true
                done
                rm -f "$INSTANCES"
            else
                for _unit in $(running_instances); do
                    deb-systemd-invoke restart "$_unit" >/dev/null || true
                done
            fi
        fi
    fi
fi

exit 0
