{
  // pdn-mailcast-headend. Every key has a default except the ones that name your station:
  // "callsign", "station"."apiKey" and the daylight "locator", empty here, and the BBS logins,
  // Q0HEAD here; the service will not start until the empty ones are set. docs/headend.md says what
  // each one does, and docs/run-your-own-headend.md how to set one up. The slot settings here are
  // a slot every hour on the hour in daylight; the rest are the defaults.
  "callsign": "",
  "destination": "MCAST",
  // The bulletins in rotation and the slot reports are kept in /var/lib/pdn-mailcast-headend, or
  // /var/lib/pdn-mailcast-headend-NAME for /etc/pdn-mailcast-headend/NAME.json, a second head end
  // (pdn-mailcast-headend@NAME). Leave "stateDirectory" out so that each keeps its own.

  // How bulletins are carried: "budget" (the default for any slot interval but a day) fills each
  // slot to "budgetMinutes" on the air, tone and idents included, but always leaves the
  // clear-channel wait ("marginSeconds", or "channelWaitSeconds" if left out) and a carrier wait before
  // "slot"."maxMinutes". Each slot sends fresh pieces of every bulletin in rotation, the least
  // covered first, at most "slotCap" times a bulletin's pieces in one slot; a bulletin retires
  // after "retireCoverage" times its pieces in all, or "retireHours" after its first slot.
  // "shares" is the earlier rule, with "slotShares", "slotOffsets", "extraSymbols" and
  // "carryOverSlots". "modes" lists waveforms the slots take in turn, such as
  // ["ms110d-wn4", "ms110d-wn3"]; left out, every slot goes on "station"."mode".
  "schedule": {
    "rule": "budget",
    "budgetMinutes": 10,
    "slotCap": 0.6,
    "retireCoverage": 6,
    "retireHours": 36
  },

  // A slot at "minute" past the hour (0 to 59, counted from 00:MM UTC) and then every "everyMinutes" (dividing a day, at least 15). Left out,
  // "everyMinutes" is 1440, one slot a day, and then "toneSeconds" is 30, "maxMinutes" 40 and
  // "catchUpMinutes" 30. Receivers expect a 10 s tone in an hourly slot.
  // "daylight" runs only the slots that start from "afterSunriseMinutes" after sunrise to
  // "beforeSunsetMinutes" before sunset at "locator", worked out from the sun for each day, in
  // UTC; left out, every slot runs. --run-now runs whatever the time.
  // "minute" 30 with "everyMinutes" 60 is a slot at half past each hour.
  "slot": {
    "minute": 0,
    "everyMinutes": 60,
    "daylight": { "locator": "", "afterSunriseMinutes": 120, "beforeSunsetMinutes": 30 },
    "catchUpMinutes": 5,
    "requireClockSync": true,
    "retryMinutes": 5,
    "maxMinutes": 10,
    "channelWaitSeconds": 120,
    "whenStillBusy": "go",
    "toneSeconds": 10,
    "toneHz": 1800,
    "pauseAfterToneSeconds": 8,
    "burstGapSeconds": 1
  },

  // The station's pdn-soundmodem: its API (the page port and api.key) and the bulletin modem's
  // own KISS port and sub-channel, as in its modems[] entry.
  "station": {
    "apiUrl": "http://127.0.0.1:8107/",
    "apiKey": "",
    "kissHost": "127.0.0.1",
    "kissPort": 8112,
    "kissPortNibble": 0,
    "subChannel": 4,
    "mode": "ms110d-wn4",
    "maxBurstSeconds": 60,
    "leaseSeconds": 120,
    "maxCarrierWaitSeconds": 10,
    "renewSeconds": 30,
    "ackGraceSeconds": 120
  },

  // Read-only: PA temperature and the frequency reference. Never takes a slice or keys anything.
  "flex": {
    "enabled": false,
    "host": "",
    "port": 4992,
    "paTemperatureLimitC": 70,
    "paStaleSeconds": 15,
    "whenUnreachable": "carryOn"
  },

  // Bulletin files dropped in "drop" in the state directory are taken in too; "dropDirectory"
  // names another, or "" for none.
  "intake": {
    "maxBulletinBytes": 32768,
    "preSlotSeconds": 30,
    // The head end calls the BBS's forwarding port as a partner and takes the bulletins queued
    // for it. This login is LinBPQ's FBBPORT (no prompts: user, password, then BBS); for pdn-bbs's
    // fbbTcp port it is [{ "expect": "Callsign :", "send": "{call}" }]. Remove this section to use
    // the drop directory alone.
    "fbb": {
      "host": "127.0.0.1",
      "port": 8011,
      "partnerCallsign": "Q0HEAD",
      "user": "Q0HEAD",
      "password": "",
      "login": [
        { "send": "{user}" },
        { "send": "{password}" },
        { "send": "BBS" }
      ],
      "pollMinutes": 30,
      "sessionTimeoutSeconds": 300
    }
    // To tell listeners whose daily reports reached the BBS, add a login the head end can list
    // them with (L> MCAST) as an ordinary reader, before each slot and at most every 15 minutes.
    // Left out, nothing is read and the directory says nothing about reports. For example:
    // "reports": { "host": "127.0.0.1", "port": 8011, "user": "Q0CAST", "password": "" }
  },

  // The ionosonde reading: is 40 m open from the UK, and how far out. Observe only: it is logged,
  // reported and sent to receivers as a tiny object, and never changes what or when the head end
  // sends. A distance (100, 500, 1000 km) is open when its MUF is at least "openMhz", reliable
  // when "reliableFactor" times it still is; a sounding older than "staleMinutes" is UNKNOWN. The
  // first of "stations" with a fresh sounding is used; [] turns the reading off.
  "ionosphere": {
    "openMhz": 7.1,
    "reliableFactor": 0.85,
    "staleMinutes": 45,
    "stations": ["FF051", "RL052", "DB049"]
  },

  // The PSK Reporter reading: the last 30 minutes of FT8, FT4 and WSPR spots on 40 and 80 m
  // between stations in the UK and Ireland, from PSK Reporter's public MQTT feed, say whether
  // 40 m is open at 100, 500 and 1000 km. Observe only, like the ionosonde's; 40 m is sent to
  // receivers, 80 m is only shown here. "enabled": false turns it off.
  "pskReporter": {
    "enabled": true,
    "host": "mqtt.pskreporter.info",
    "port": 1883
  },

  // Where this station's signal is centred (Hz, the same number another station would advertise
  // for you), its sideband and its Maidenhead locator. All optional; given, every directory
  // carries them so receivers know where to listen for you and where the path starts. For example:
  // "frequencyHz": 7053800, "sideband": "usb", "locator": "IO91lk",

  // Other mailcast stations to tell listeners about in every directory, so their receivers
  // also listen at those stations' slots. Only a hint about where to listen: receivers trust a
  // station from its own signed directory. For example:
  // { "callsign": "G8BPQ", "slot": { "minute": 30, "everyMinutes": 60 }, "frequencyHz": 7053800, "sideband": "usb", "locator": "IO83" }
  "advertise": [],

  // GET /status for the state; POST /run (pdn-mailcast-headend --run-now) for a one-off slot,
  // accepted only from this machine.
  "status": {
    "bind": "127.0.0.1",
    "port": 8216
  }
}
