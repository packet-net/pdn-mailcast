{
  // pdn-mailcast-headend. Every key has a default except "station"."apiKey"; the service will not
  // start until that is set. docs/headend.md says what each one does. The slot settings here are
  // GB7RDG's, a slot every hour on the hour in daylight; the rest are the defaults.
  "callsign": "GB7RDG",
  "destination": "MCAST",
  "stateDirectory": "/var/lib/pdn-mailcast-headend",

  // Frame size: the bytes of bulletin per frame, 64 to 940 in steps of 4. Smaller frames survive
  // fades and other stations better; docs/headend.md says more. How each bulletin is carried
  // ("slotShares", "slotOffsets", "extraSymbols", "carryOverSlots") is left to the defaults for
  // the slot interval: for hourly in daylight, 1.2 times its pieces in the first slot after it
  // arrives and 0.4 times again 5 hours later, or in the next daylight slot if that is dark.
  // Without "daylight", the first slot and again 5, 10, 17 and 25 hours later.
  "schedule": {
    "symbolSize": 240
  },

  // A slot at "timeUtc" and then every "everyMinutes" (dividing a day, at least 15). Left out,
  // "everyMinutes" is 1440, one slot a day, and then "toneSeconds" is 30, "maxMinutes" 40 and
  // "catchUpMinutes" 30. Receivers expect GB7RDG every hour on the hour with a 10 s tone.
  // "daylight" runs only the slots that start from "afterSunriseMinutes" after sunrise to
  // "beforeSunsetMinutes" before sunset at "locator", worked out from the sun for each day, in
  // UTC; left out, every slot runs. --run-now runs whatever the time.
  "slot": {
    "timeUtc": "00:00",
    "everyMinutes": 60,
    "daylight": { "locator": "IO91lk", "afterSunriseMinutes": 120, "beforeSunsetMinutes": 30 },
    "catchUpMinutes": 5,
    "requireClockSync": true,
    "retryMinutes": 5,
    "maxMinutes": 10,
    "channelWaitSeconds": 120,
    "whenStillBusy": "go",
    "toneSeconds": 10,
    "toneHz": 1800,
    "pauseAfterToneSeconds": 8,
    "burstGapSeconds": 1
  },

  // The station's pdn-soundmodem: its API (the page port and api.key) and the bulletin modem's
  // own KISS port and sub-channel, as in its modems[] entry.
  "station": {
    "apiUrl": "http://127.0.0.1:8107/",
    "apiKey": "",
    "kissHost": "127.0.0.1",
    "kissPort": 8112,
    "kissPortNibble": 0,
    "subChannel": 4,
    "mode": "ms110d-wn4",
    "maxBurstSeconds": 60,
    "leaseSeconds": 120,
    "maxCarrierWaitSeconds": 10,
    "renewSeconds": 30,
    "ackGraceSeconds": 120
  },

  // Read-only: PA temperature and the frequency reference. Never takes a slice or keys anything.
  "flex": {
    "enabled": false,
    "host": "",
    "port": 4992,
    "paTemperatureLimitC": 70,
    "paStaleSeconds": 15,
    "whenUnreachable": "carryOn"
  },

  "intake": {
    "dropDirectory": "/var/lib/pdn-mailcast-headend/drop",
    "maxBulletinBytes": 32768,
    "preSlotSeconds": 30,
    // The head end calls the BBS's forwarding port as a partner and takes the bulletins queued
    // for it. This login is LinBPQ's FBBPORT (no prompts: user, password, then BBS); for pdn-bbs's
    // fbbTcp port it is [{ "expect": "Callsign :", "send": "{call}" }]. Remove this section to use
    // the drop directory alone.
    "fbb": {
      "host": "127.0.0.1",
      "port": 8011,
      "partnerCallsign": "Q0HEAD",
      "user": "Q0HEAD",
      "password": "",
      "login": [
        { "send": "{user}" },
        { "send": "{password}" },
        { "send": "BBS" }
      ],
      "pollMinutes": 30,
      "sessionTimeoutSeconds": 300
    }
  },

  // GET /status for the state; POST /run (pdn-mailcast-headend --run-now) for a one-off slot,
  // accepted only from this machine.
  "status": {
    "bind": "127.0.0.1",
    "port": 8216
  }
}
