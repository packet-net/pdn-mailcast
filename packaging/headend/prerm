#!/bin/sh
set -e

UNIT=pdn-mailcast-headend.service
# Set while an upgrade has the service stopped, so postinst knows to start it again.
MARK=/run/pdn-mailcast-headend.upgrade-was-running

if [ -d /run/systemd/system ] && command -v deb-systemd-invoke >/dev/null; then
    case "$1" in
        remove)
            deb-systemd-invoke stop "$UNIT" >/dev/null || true
            ;;
        upgrade)
            # Stop before dpkg replaces the files, not after: a .NET service still running
            # loads some assemblies lazily, and one shutting down after the swap can find a
            # different version of a library it needs (0.9.1 to 0.12.0 crashed in
            # FlexMonitor.CloseAsync looking for its old M0LTE.Flex). postinst starts it again.
            if systemctl --quiet is-active "$UNIT" 2>/dev/null; then
                : > "$MARK"
                deb-systemd-invoke stop "$UNIT" >/dev/null || true
            fi
            ;;
    esac
fi

exit 0
