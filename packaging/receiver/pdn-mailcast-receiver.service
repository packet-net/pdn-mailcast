[Unit]
Description=pdn-mailcast receiver: GB7RDG's bulletins into your BBS
Documentation=https://github.com/packet-net/pdn-mailcast/blob/main/src/Mailcast.Receiver/README.md
After=network-online.target sound.target time-sync.target
Wants=network-online.target time-sync.target
ConditionPathExists=/etc/pdn-mailcast/receiver.json

[Service]
Type=simple
ExecStart=/usr/bin/pdn-mailcast-receiver --config /etc/pdn-mailcast/receiver.json
Restart=on-failure
RestartSec=10
# Exit 2 means the configuration is wrong, and the journal says what to fix. Restarting would
# only bury that under copies of itself.
RestartPreventExitStatus=2
User=pdn-mailcast
Group=pdn-mailcast
# /var/lib/pdn-mailcast: the pieces heard, the rebuilt bulletins and the delivery record.
StateDirectory=pdn-mailcast
StateDirectoryMode=0750
# audio: the sound card, for a receiver on a radio rather than a web SDR.
SupplementaryGroups=audio
# Files it makes (the pieces, the delivery record, a saved config) are for it alone; the config
# is made group-readable explicitly when it is saved.
UMask=0077
NoNewPrivileges=true
ProtectHome=true
# Everything read-only but /dev, /proc, /sys, the state directory and, because the status page
# writes settings back to the config file, /etc/pdn-mailcast. /dev stays as it is, so the sound
# card is reached through the audio group above.
ProtectSystem=strict
ReadWritePaths=/etc/pdn-mailcast
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
# IP for the BBS and the web SDR, Unix sockets for .NET's own, netlink for its interface list.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
MemoryMax=1G

[Install]
WantedBy=multi-user.target
