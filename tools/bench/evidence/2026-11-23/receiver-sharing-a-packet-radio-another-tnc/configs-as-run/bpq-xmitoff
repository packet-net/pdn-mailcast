#!/bin/sh
# Tells LinBPQ to stop transmitting on one port (bpq-xmitoff 1) or lets it again (bpq-xmitoff 0),
# for the receiver's "before" and "after" hooks. Needs nc from netcat-openbsd. Set these five,
# and keep the file from other users, since it holds a sysop password:
HOST=127.0.0.1     # where LinBPQ is
PORT=8011          # its Telnet port's FBBPORT
USER=sysop         # a user whose USER= line in bpq32.cfg ends in SYSOP
PASSWORD=change-me
HFPORT=2           # LinBPQ's port number for the radio, as its PORTS command lists it

answer=$({ printf '%s\r%s\r' "$USER" "$PASSWORD"; sleep 2; printf 'PASSWORD\r'; sleep 1
           printf 'XMITOFF %s %s\r' "$HFPORT" "$1"; sleep 2; printf 'BYE\r'; sleep 1
         } | nc -w 10 "$HOST" "$PORT" | tr '\r' '\n')
said=$(printf '%s\n' "$answer" | grep "XMITOFF was [01] now $1" | head -n 1)
if [ -n "$said" ]; then
  echo "LinBPQ port $HFPORT: $said"
else
  echo "LinBPQ did not confirm XMITOFF $HFPORT $1; it said: $answer"
  exit 1
fi
