# The variant with CAT: a "rig" section and keying through rigctld added to soundmodem.json.
# The radio is a Hamlib dummy rig left on 432.000000 MHz; pdn-soundmodem has to move it, and
# the air follows wherever it goes.
. $B/scenarios/qo100-head-end.env
TX_PATCH='.rig={rigctld:"127.0.0.1:4531"} | .ptt={type:"rigctld"}'
RIGS="headend:4531:432000000:USB:2400"
TX_DIAL=rig:127.0.0.1:4531; air
