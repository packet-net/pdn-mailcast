# Two more things that could key the listener's radio around a slot: an ARDOP modem beside the
# packet one, and packet frames already going out when the radio is due to move. And the
# receiver's own "hooks", to see when they run in this set-up.
. $B/scenarios/receiver-sharing-a-packet-radio.env
RX_PATCH='.modems += [{"subChannel":1,"mode":"ardop","rfFrequency":7050800,"bandwidth":500,"port":8515}]'
RECEIVER_PATCH='.hooks={before:{command:"/repo/tools/bench/scenarios/log-hook.sh",args:["before"]},after:{command:"/repo/tools/bench/scenarios/log-hook.sh",args:["after"]}}'
DURING=transmit-paths.sh
