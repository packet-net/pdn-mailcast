# The variant with the dial pinned: "dialFrequency": 2400130000 puts the modem at 1800 Hz
# audio, and the transmit radio is on 2400.130000 MHz.
. $B/scenarios/qo100-head-end.env
TX_PATCH='.dialFrequency=2400130000'
AIR="--tx $R/tx.out@10489630000 --rx alsa:plughw:CARD=Loopback,DEV=0,SUBDEV=$SUB@10489630000"
