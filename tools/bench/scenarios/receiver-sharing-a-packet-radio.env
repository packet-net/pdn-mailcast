# docs/examples/receiver-sharing-a-packet-radio, hearing the bench's stand-in for M0LTE on
# 7.0538 MHz. The listener's radio is a Hamlib dummy rig left on the packet dial, 7.050100 MHz;
# the air follows wherever pdn-soundmodem moves it. Two minutes into the slot the listener's
# packet modem is handed a frame to send, to see it held until the radio is back.
RX_SOUNDMODEM=$X/receiver-sharing-a-packet-radio/soundmodem.json
RECEIVER=$X/receiver-sharing-a-packet-radio/receiver.json
RIGS="listener:4532:7050100:USB:2400"
AIR="--tx $R/tx.out@7052300 --rx $R/rx.in@rig:127.0.0.1:4532 --watch $R/rx.out@rig:127.0.0.1:4532"
DURING=queue-a-packet-frame.sh
RUN_MINUTES=14
