# The LNB receiver with the LNB's nominal 9750 MHz in both files, uncalibrated, while the
# oscillator is really 12.345 kHz above that.
. $B/scenarios/qo100-head-end.env
RX_PATCH='.waterfall.port=8109 | .kissPort=8305 | .dialFrequency=739630000'
RECEIVER2_PATCH='.audio="soundmodem:8109" | .web.port=8131 | .lnbHz=9750000000'
