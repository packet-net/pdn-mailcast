# docs/examples/receiver-sharing-a-packet-radio with receiver-with-another-tnc.json: the radio
# is moved through pdn-soundmodem as before, but LinBPQ transmits through a KISS TNC of its own
# that pdn-soundmodem knows nothing of, so the receiver's hooks send LinBPQ XMITOFF around each
# slot. LinBPQ is real; its TNC is the bench's stand-in, which keys the dummy rig and writes
# down where the dial was. LinBPQ sends its ID every minute.
. $B/scenarios/receiver-sharing-a-packet-radio.env
RECEIVER=$X/receiver-sharing-a-packet-radio/receiver-with-another-tnc.json
INSTALL="$X/receiver-sharing-a-packet-radio/bpq-xmitoff:/usr/local/bin/bpq-xmitoff"
KISS_TNC=8100:4532
LINBPQ=$B/stand-in/bpq32.cfg
DURING=
