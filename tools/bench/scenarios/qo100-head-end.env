# docs/examples/qo100-head-end as written, heard by docs/examples/qo100-receiver-sound-card.
# The transmit radio is on the dial pdn-soundmodem prints, 2400.130300 MHz; the air works in
# downlink frequencies, so that is 10489.630300 MHz (the transponder adds 8089.5 MHz).
TX_SOUNDMODEM=$X/qo100-head-end/soundmodem.json
HEADEND=$X/qo100-head-end/headend.json
RECEIVER=$X/qo100-receiver-sound-card/receiver.json
RECEIVER_STATIONS=$X/qo100-receiver-sound-card/stations.json
AIR="--tx $R/tx.out@10489630300 --rx alsa:plughw:CARD=Loopback,DEV=0,SUBDEV=$SUB@10489630000"
