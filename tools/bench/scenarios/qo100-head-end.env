# docs/examples/qo100-head-end as written, heard two ways at once: by
# docs/examples/qo100-receiver-sound-card and by docs/examples/qo100-receiver-lnb-rtl-sdr.
#
# The transmit radio is on the dial pdn-soundmodem prints, 432.130300 MHz. The air works in
# downlink frequencies, so the transverter's 1968 MHz and the transponder's 8089.5 MHz are
# added to it: 10057.5 MHz in all.
TX_SOUNDMODEM=$X/qo100-head-end/soundmodem.json
HEADEND=$X/qo100-head-end/headend.json
TX_DIAL=432130300
UP=10057500000
# The sound card receiver's web SDR is on 10489.630000 MHz USB.
RECEIVER=$X/qo100-receiver-sound-card/receiver.json
RECEIVER_STATIONS=$X/qo100-receiver-sound-card/stations.json
# The LNB receiver's dongle is an emulated rtl_tcp server on port 1234, behind an LNB whose
# oscillator is LNB_HZ. Its pdn-soundmodem and receiver share this container with the head
# end's, so three ports move out of the way; on a machine of their own they stay as written.
RX_SOUNDMODEM=$X/qo100-receiver-lnb-rtl-sdr/soundmodem.json
RX_PATCH='.waterfall.port=8109 | .kissPort=8305'
RECEIVER2=$X/qo100-receiver-lnb-rtl-sdr/receiver.json
RECEIVER2_PATCH='.audio="soundmodem:8109" | .web.port=8131'
RECEIVER2_STATIONS=/usr/share/pdn-mailcast-receiver/stations.json
LNB_HZ=9750012345
air() { AIR="--tx $R/tx.out@$TX_DIAL+$UP --rx alsa:plughw:CARD=Loopback,DEV=0,SUBDEV=$SUB@10489630000 --rx rtltcp:1234@$LNB_HZ"; }
air
