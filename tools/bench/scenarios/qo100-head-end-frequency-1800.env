# The variant with no band plan: "frequency": 1800 in place of "rfFrequency", and the
# transmit radio on 2400.130000 MHz.
. $B/scenarios/qo100-head-end.env
TX_PATCH='.modems[0] |= (del(.rfFrequency) | .frequency=1800)'
AIR="--tx $R/tx.out@10489630000 --rx alsa:plughw:CARD=Loopback,DEV=0,SUBDEV=$SUB@10489630000"
